{
  "name": "@wiltech-labs/ngx-organization",
  "version": "1.0.0",
  "description": "Shared Angular org chart — organization, org entities, departments and jobs on a pan/zoom canvas, Material 3 styled, with a node detail side panel.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "dependencies": {
    "ngx-interactive-org-chart": "^1.5.0",
    "@wiltech-labs/ngx-api-client": "file:../api-client/dist",
    "@wiltech-labs/ngx-auth": "file:../auth/dist",
    "@wiltech-labs/ngx-modals": "file:../modals/dist"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/material": "^22.0.0",
    "rxjs": "^7.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "postbuild": "node ../../scripts/fix-dist-file-deps.js .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/material": "^22.0.0",
    "ng-packagr": "^22.0.0",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2"
  }
}
