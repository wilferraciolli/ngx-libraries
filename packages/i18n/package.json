{
  "name": "@wiltech-labs/ngx-i18n",
  "version": "1.0.0",
  "description": "Shared Angular i18n — instant (no-reload) language switching on Transloco, a t() service/pipe, locale-aware date/number formatting, and a pluggable locale-resolution order.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "dependencies": {
    "@jsverse/transloco": "^8.0.0"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.2"
  }
}
